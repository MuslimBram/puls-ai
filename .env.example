# Copy to .env and fill in your own Supabase project values.
# The publishable (anon) key is safe for the browser ONLY when RLS is enabled
# on all tables. Never put the service-role key in any VITE_* variable.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
